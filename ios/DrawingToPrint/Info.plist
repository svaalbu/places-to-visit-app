<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Drawing to Print</string>
	<key>NSCameraUsageDescription</key>
	<string>Drawing to Print photographs your drawing so it can generate a 3D model to print.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Drawing to Print uses a photo of your drawing to generate a 3D model to print.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>3D Manufacturing Format</string>
			<key>UTTypeIdentifier</key>
			<string>org.3mf.model</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>3mf</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>model/3mf</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
