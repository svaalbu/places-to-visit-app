{
  "expo": {
    "name": "Bordbok",
    "slug": "Bordbok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bordbok",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.bordbok.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Bordbok saves a photo from each café or restaurant you visit.",
        "NSCameraUsageDescription": "Bordbok can use the camera for a photo from the table.",
        "NSLocationWhenInUseUsageDescription": "Bordbok can center the Oslo map around you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EDE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3EDE3"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bordbok saves a photo from each café or restaurant you visit."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
